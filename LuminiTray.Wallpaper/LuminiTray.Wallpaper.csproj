<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LuminiTray.Wallpaper</AssemblyName>
    <Product>Lumini Tray</Product>
    <Title>Lumini Tray - Papel de Parede Animado</Title>
    <Description>Lumini Tray - Papel de Parede Animado</Description>
    <AssemblyTitle>Lumini Tray - Papel de Parede Animado</AssemblyTitle>
    <Version>0.24.1</Version>
    <FileVersion>0.24.1.0</FileVersion>
    <AssemblyVersion>0.24.1.0</AssemblyVersion>
    <ApplicationIcon>..\LuminiTray\Assets\app.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
