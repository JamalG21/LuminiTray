<Window x:Class="LuminiTray.MicOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumini Tray - Microfone"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Cursor="Hand"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border x:Name="OverlayCard"
            Background="#E6101010"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="18"
            Padding="12,6,14,6"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Indicador Circular com Ícone de Microfone -->
            <Border x:Name="IndicatorCircle" Width="26" Height="26" CornerRadius="13" Background="#10B981" Margin="0,0,10,0">
                <TextBlock x:Name="IconMic"
                           Text="&#xE720;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Status do Microfone e Dica -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus"
                           Text="MIC ABERTO"
                           Foreground="#F5F5F5"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11.5"
                           FontWeight="Bold"/>
                <TextBlock x:Name="TxtHint"
                           Text="Clique para mutar"
                           Foreground="#888888"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="9.5"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
