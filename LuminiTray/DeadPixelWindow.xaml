<Window x:Class="LuminiTray.DeadPixelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verificador de Dead Pixels"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="None"
        Background="Black"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown">
    <Grid>
        <!-- Overlay HUD inicial informando controles -->
        <Border x:Name="HudNotice"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,40,0,0"
                Background="#CC0A0A0A"
                BorderBrush="#00D2FF"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24,14">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TxtColorName" Text="COR ATUAL: PRETO (BLACK)" Foreground="#00D2FF" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Clique com botão esquerdo ou use Setas/Espaço para alternar as cores." Foreground="#F5F5F5" FontSize="12" Margin="0,4,0,2" HorizontalAlignment="Center"/>
                <TextBlock Text="Pressione [ESC] ou dê clique duplo para sair do teste de tela cheia." Foreground="#8C8C8C" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
