<Window x:Class="LuminiTray.TaskbarVolumeOsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="{DynamicResource Card}" CornerRadius="12" BorderBrush="{DynamicResource CardBorderColor}" BorderThickness="1.2"
            Padding="14,10" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.8" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Vertical" Width="185">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtIcon" Grid.Column="0" Text="&#xE767;" FontFamily="{DynamicResource Icons}" FontSize="15"
                           Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtTitle" Grid.Column="1" Text="Volume" Foreground="{DynamicResource Fg}" FontSize="11.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110"/>
                <TextBlock x:Name="TxtPercent" Grid.Column="2" Text="100%" Foreground="{DynamicResource Accent}" FontSize="12.5" FontWeight="Bold"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            <!-- Barra de Progresso com estilo refinado arredondado com cores do tema -->
            <Border Height="5" CornerRadius="2.5" Background="{DynamicResource Line}" ClipToBounds="True">
                <ProgressBar x:Name="PbVolume" Height="5" Minimum="0" Maximum="100" Value="50"
                             Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
