<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>LuminiTray</AssemblyName>
    <Product>Lumini Tray</Product>
    <Title>Lumini Tray</Title>
    <Version>0.35.0</Version>
    <AssemblyVersion>0.35.0.0</AssemblyVersion>
    <FileVersion>0.35.0.0</FileVersion>
    <!-- Sempre otimizado: o LUMINI BENCH e os stress tests precisam do JIT otimizado tambÃƒÂ©m em Debug -->
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- OtimizaÃƒÂ§ÃƒÂµes de Tamanho em Disco e MemÃƒÂ³ria RAM -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <GarbageCollectionAdaptationMode>1</GarbageCollectionAdaptationMode>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo-badge.png" />
    <Resource Include="Assets\logo-dark.png" />
  </ItemGroup>

  <!-- Drivers seriais oficiais embutidos (LUMINI MAKER): cada pasta Drivers\<chip> vira recurso e ÃƒÂ© extraÃƒÂ­da na hora de instalar.
       Para incluir outro, basta criar a pasta com o .inf/.cat/.sys e ligÃƒÂ¡-la em MakerDrivers.Chips (Bundle). -->
  <ItemGroup>
    <EmbeddedResource Include="Drivers\**\*" Exclude="Drivers\*.md;Drivers\*.txt" LogicalName="Drivers/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Debloat\Apps.json" LogicalName="Debloat/Apps.json" />
    <EmbeddedResource Include="Assets\Debloat\pt-BR\Apps.json" LogicalName="Debloat/pt-BR/Apps.json" />
    <EmbeddedResource Include="Assets\Drivers\VBCable.zip" LogicalName="Drivers/VBCable.zip" />
  </ItemGroup>

  <!-- iCUE SDK da Corsair (RESET INTEGRAÃƒâ€¡ÃƒÆ’O): se a DLL estiver em Native\, ela vai junto do .exe. NÃƒÂ£o ÃƒÂ© versionada no git. -->
  <ItemGroup>
    <None Include="Native\iCUESDK.x64_2019.dll" Condition="Exists('Native\iCUESDK.x64_2019.dll')" Link="iCUESDK.x64_2019.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\SDL2.dll" Condition="Exists('Native\SDL2.dll')" Link="SDL2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\NvAPIWrapper.dll" Condition="Exists('Native\NvAPIWrapper.dll')" Link="NvAPIWrapper.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\rnnoise.dll" Condition="Exists('Native\rnnoise.dll')" Link="rnnoise.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\LuminiTray.NativeCore.dll" Condition="Exists('Native\LuminiTray.NativeCore.dll')" Link="LuminiTray.NativeCore.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Native\LuminiTray.NativeCore.dll.sha256" Condition="Exists('Native\LuminiTray.NativeCore.dll.sha256')" Link="LuminiTray.NativeCore.dll.sha256" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\AMD\PawnIO\RyzenSMU.bin" Condition="Exists('Assets\AMD\PawnIO\RyzenSMU.bin')" Link="RyzenSMU.bin" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NvAPIWrapper">
      <HintPath>Native\NvAPIWrapper.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="LuminiTray.Tests\**" />
    <None Remove="LuminiTray.Tests\**" />
    <Compile Remove="SoundSwitch-7.4.0-beta.2\**" />
    <None Remove="SoundSwitch-7.4.0-beta.2\**" />
    <Compile Remove="AHK_MicMute-1.3.4\**" />
    <None Remove="AHK_MicMute-1.3.4\**" />
    <Compile Remove="smartmontools-RELEASE_7_5\**" />
    <None Remove="smartmontools-RELEASE_7_5\**" />
    <Compile Remove="perifÃƒÂ©ricos\**" />
    <None Remove="perifÃƒÂ©ricos\**" />
    <Page Remove="perifÃƒÂ©ricos\**" />
    <ApplicationDefinition Remove="perifÃƒÂ©ricos\**" />
    <Compile Remove="perifericos\**" />
    <None Remove="perifericos\**" />
    <Page Remove="perifericos\**" />
    <ApplicationDefinition Remove="perifericos\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="SpeedTest.Net" Version="1.3.0" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Native\LuminiTray.TaskbarHook.dll" LogicalName="LuminiTray.TaskbarHook.dll" />
    <EmbeddedResource Include="Native\LuminiTray.NativeCore.dll" Condition="Exists('Native\LuminiTray.NativeCore.dll')" LogicalName="LuminiTray.NativeCore.dll" />
  </ItemGroup>

  <PropertyGroup>
    <RustCargoExe>$(USERPROFILE)\.cargo\bin\cargo.exe</RustCargoExe>
    <RustCoreManifest>..\LuminiTray.NativeCore\Cargo.toml</RustCoreManifest>
    <RustCoreBuiltDll>..\LuminiTray.NativeCore\target\x86_64-pc-windows-msvc\release\luminitray_nativecore.dll</RustCoreBuiltDll>
  </PropertyGroup>

  <Target Name="BuildRustNativeCore" BeforeTargets="BeforeBuild"
          Inputs="$(RustCoreManifest);..\LuminiTray.NativeCore\src\lib.rs;..\LuminiTray.NativeCore\src\disk.rs;..\LuminiTray.NativeCore\src\frames.rs;..\LuminiTray.NativeCore\src\dsp.rs"
          Outputs="Native\LuminiTray.NativeCore.dll">
    <Exec Condition="Exists('$(RustCargoExe)') And Exists('$(RustCoreManifest)')"
          WorkingDirectory="..\LuminiTray.NativeCore"
          Command="&quot;$(RustCargoExe)&quot; build --release --target x86_64-pc-windows-msvc" />
    <Copy Condition="Exists('$(RustCoreBuiltDll)')"
          SourceFiles="$(RustCoreBuiltDll)"
          DestinationFiles="Native\LuminiTray.NativeCore.dll"
          SkipUnchangedFiles="true" />
    <Exec Condition="Exists('$(RustCargoExe)') And Exists('Native\LuminiTray.NativeCore.dll')"
          Command="powershell -NoProfile -Command &quot;$h=(Get-FileHash 'Native\LuminiTray.NativeCore.dll' -Algorithm SHA256).Hash.ToLowerInvariant(); Set-Content 'Native\LuminiTray.NativeCore.dll.sha256' ($h + '  LuminiTray.NativeCore.dll') -NoNewline&quot;" />
    <Message Condition="!Exists('$(RustCargoExe)')"
             Importance="High"
             Text="Rust/Cargo nao detectado; usando Native\LuminiTray.NativeCore.dll pre-compilada (ou fallback C#)." />
  </Target>

  <Target Name="CopySubtaskExecutables" AfterTargets="Build">
    <Copy SourceFiles="@(SubtaskExes)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <SubtaskExes Include="Assets\Subtasks\*.exe" />
  </ItemGroup>

</Project>
