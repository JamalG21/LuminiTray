                            <Button x:Name="BtnStartupScan" Style="{StaticResource PrimaryButton}" Content="ATUALIZAR DIAGNÓSTICO" Padding="20,9" HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnStartupScan_Click"/>

