                                                <CheckBox x:Name="ChkAutoStartMinimized" Content="Iniciar minimizado ao ligar o PC" FontWeight="SemiBold" FontSize="12.5" Click="AutoFeatureOption_Click"/>

                                                <TextBlock Text="Abre minimizado sem interromper sua área de trabalho ao ligar o computador." Foreground="{DynamicResource Faint}" FontSize="11" Margin="24,2,0,0" TextWrapping="Wrap"/>

                                            </StackPanel>

                                        </Grid>

