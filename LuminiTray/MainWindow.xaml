                        <!-- Card 1: TEMPO PARA LIGAR & DIAGNÓSTICO DE INICIALIZAÇÃO -->

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="22">

                            <StackPanel>

                                <TextBlock Text="TEMPO PARA LIGAR O COMPUTADOR" Style="{StaticResource Label}" Margin="0,0,0,14"/>

                                <Grid Margin="0,0,0,16">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                            <TextBlock x:Name="TxtBootTypicalTime" Text="-- s" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource Mono}"/>

                                            <TextBlock Text=" tempo típico para ligar" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="10,6,0,0"/>

                                        </StackPanel>

                                        <TextBlock x:Name="TxtBootSummaryDetail" Text="Tempo medido desde o acionamento do hardware até a área de trabalho pronta para uso." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                    </StackPanel>



                                    <!-- Badge Início Rápido -->

                                    <Border x:Name="BadgeFastStartup" Grid.Column="1" Background="{DynamicResource CardSubtleBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,8" VerticalAlignment="Center">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock x:Name="IcoFastStartup" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                            <TextBlock x:Name="TxtFastStartupBadge" Text="Início rápido do Windows ativo" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>

                                        </StackPanel>

                                    </Border>

                                </Grid>



                                <!-- Boot Breakdown Cards: Kernel & Main Path, Post Boot Apps, Desktop Idle -->

                                <Grid Margin="0,0,0,20">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="12"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="12"/>

                                        <ColumnDefinition Width="*"/>

                                    </Grid.ColumnDefinitions>



                                    <Border Grid.Column="0" Background="{DynamicResource CardSubtleBg}" CornerRadius="8" Padding="14,12">

                                        <StackPanel>

                                            <TextBlock Text="CAMINHO PRINCIPAL (KERNEL &amp; DRIVERS)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Faint}"/>

                                            <TextBlock x:Name="TxtBootMainPathTime" Text="-- s" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Fg}" Margin="0,4,0,0"/>

                                            <TextBlock Text="Inicialização do kernel, drivers essenciais e subsistema de vídeo." FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </Border>



                                    <Border Grid.Column="2" Background="{DynamicResource CardSubtleBg}" CornerRadius="8" Padding="14,12">

                                        <StackPanel>

                                            <TextBlock Text="PÓS-INICIALIZAÇÃO (APPS &amp; BANDEJA)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Faint}"/>

                                            <TextBlock x:Name="TxtBootPostBootTime" Text="-- s" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Fg}" Margin="0,4,0,0"/>

                                            <TextBlock Text="Tempo até a área de trabalho carregar os utilitários e atingir ociosidade." FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </Border>



                                    <Border Grid.Column="4" Background="{DynamicResource CardSubtleBg}" CornerRadius="8" Padding="14,12">

                                        <StackPanel>

                                            <TextBlock Text="ÚLTIMA INICIALIZAÇÃO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Faint}"/>

                                            <TextBlock x:Name="TxtBootLastDate" Text="Hoje" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Fg}" Margin="0,4,0,0"/>

                                            <TextBlock x:Name="TxtBootLastUptime" Text="Uptime atual: --" FontSize="10.5" Foreground="{DynamicResource Muted}" Margin="0,2,0,0" TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </Border>

                                </Grid>



                                <!-- Visual Timeline: Histórico das últimas inicializações -->

                                <TextBlock Text="HISTÓRICO DAS ÚLTIMAS INICIALIZAÇÕES" Style="{StaticResource Label}" Margin="0,0,0,10"/>

                                <Border Background="{DynamicResource CardSubtleBg}" CornerRadius="8" Padding="16,12" Margin="0,0,0,18">

                                    <StackPanel>

                                        <ItemsControl x:Name="BootTimelineList">

                                            <ItemsControl.ItemTemplate>

                                                <DataTemplate>

                                                    <Grid Margin="0,4">

                                                        <Grid.ColumnDefinitions>

                                                            <ColumnDefinition Width="130"/>

                                                            <ColumnDefinition Width="*"/>

                                                            <ColumnDefinition Width="70"/>

                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding FormattedDate}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>

                                                        <Grid Grid.Column="1" Height="14" Margin="10,0" Background="{DynamicResource Line}">

                                                            <Border Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="3"/>

                                                        </Grid>

                                                        <TextBlock Grid.Column="2" Text="{Binding FormattedTotal}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Fg}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                    </Grid>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </StackPanel>

                                </Border>



                                <!-- O que atrasou o início (Degraders) -->

                                <TextBlock Text="O QUE ATRASOU O INÍCIO (GARGALOS IDENTIFICADOS)" Style="{StaticResource Label}" Margin="0,0,0,10"/>

                                <Border Background="{DynamicResource CardSubtleBg}" CornerRadius="8" Padding="16,12">

                                    <StackPanel>

                                        <TextBlock x:Name="TxtDegradersEmpty" Text="Nenhum gargalo ou atraso crítico detectado nas últimas inicializações." Foreground="{DynamicResource Muted}" FontSize="11.5" Visibility="Collapsed"/>

