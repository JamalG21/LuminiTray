                          <Button Content="🗑️ Desinstalar" Style="{StaticResource OutlineButton}" Padding="10,6" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0" Tag="{Binding}" Click="BtnUninstallNormal_Click" />

