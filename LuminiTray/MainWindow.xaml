<Window x:Class="LuminiTray.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:LuminiTray" Title="Lumini Tray" Icon="Assets/app.ico" Width="1280" Height="780" MinWidth="1020" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <WindowChrome.WindowChrome>

    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />

  </WindowChrome.WindowChrome>

  <FrameworkElement.Resources>

    <ResourceDictionary>

      <Style x:Key="NavArrowButton" TargetType="{x:Type Button}">

        <Setter Property="Width" Value="28" />

        <Setter Property="Height" Value="28" />

        <Setter Property="Background" Value="#00FFFFFF" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="BorderBrush" Value="#00FFFFFF" />

        <Setter Property="Foreground" Value="{DynamicResource Fg}" />

        <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe UI Symbol" />

        <Setter Property="FontSize" Value="12" />

        <Setter Property="FrameworkElement.Cursor" Value="Hand" />

        <Setter Property="Margin" Value="2,0" />

        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">

          <Setter.Value>

            <ControlTemplate TargetType="{x:Type Button}">

              <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4">

                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

              </Border>

              <ControlTemplate.Triggers>

                <Trigger Property="UIElement.IsMouseOver" Value="True">

                  <Setter TargetName="Bd" Value="{DynamicResource Hover}" Property="Border.Background" />

                  <Setter TargetName="Bd" Value="{DynamicResource Line}" Property="Border.BorderBrush" />

                </Trigger>

                <Trigger Property="IsPressed" Value="True">

                  <Setter TargetName="Bd" Value="{DynamicResource CardSubtleBg}" Property="Border.Background" />

                </Trigger>

                <Trigger Property="IsEnabled" Value="False">

                  <Setter Value="{DynamicResource Muted}" Property="Foreground" />

                  <Setter Property="UIElement.Opacity" Value="0.4" />

                  <Setter Property="FrameworkElement.Cursor" Value="Arrow" />

                </Trigger>

              </ControlTemplate.Triggers>

            </ControlTemplate>

          </Setter.Value>

        </Setter>

      </Style>

      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">

        <Setter Property="Background" Value="#00FFFFFF" />

        <Setter Property="Foreground" Value="{DynamicResource Fg}" />

        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />

      </Style>

      <Style x:Key="GhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">

        <Setter Property="Background" Value="#00FFFFFF" />

        <Setter Property="Foreground" Value="{DynamicResource Fg}" />

        <Setter Property="BorderBrush" Value="#00FFFFFF" />

      </Style>

      <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">

        <Setter Property="Background" Value="{DynamicResource Danger}" />

        <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />

        <Setter Property="Foreground" Value="#FFFFFF" />

      </Style>

      <DataTemplate x:Key="{DataTemplateKey {x:Type local:InfoNode}}" DataType="{x:Type local:InfoNode}">

        <StackPanel>

          <Border Name="leaf" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10">

            <Grid>

              <Grid.ColumnDefinitions>

                <ColumnDefinition Width="260" />

                <ColumnDefinition Width="*" />

              </Grid.ColumnDefinitions>

              <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,16,0" Text="{Binding Header}" />

              <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding Value}" />

            </Grid>

          </Border>

          <StackPanel Name="group" Visibility="Collapsed" Margin="0,26,0,0">

            <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" Text="{Binding Header}" />

            <ItemsControl ItemsSource="{Binding Children}" />

          </StackPanel>

        </StackPanel>

        <DataTemplate.Triggers>

          <DataTrigger Value="True" Binding="{Binding IsGroup}">

            <Setter TargetName="leaf" Property="UIElement.Visibility" Value="Collapsed" />

            <Setter TargetName="group" Property="UIElement.Visibility" Value="Visible" />

          </DataTrigger>

        </DataTemplate.Triggers>

      </DataTemplate>

      <DataTemplate x:Key="GpuTile">

        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10,18,10">

          <StackPanel>

            <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" Text="{Binding Header}" />

            <TextBlock FontSize="14" TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding Value}" />

          </StackPanel>

        </Border>

      </DataTemplate>

      <DataTemplate x:Key="GpuSection">

        <Border Margin="0,0,0,14" Padding="20,16,20,8" Style="{StaticResource CardBorder}">

          <StackPanel>

            <TextBlock Margin="0,0,0,2" Style="{StaticResource Label}" Text="{Binding Header}" />

            <ItemsControl ItemTemplate="{StaticResource GpuTile}" ItemsSource="{Binding Children}">

              <ItemsControl.ItemsPanel>

                <ItemsPanelTemplate>

                  <UniformGrid Columns="3" />

                </ItemsPanelTemplate>

              </ItemsControl.ItemsPanel>

            </ItemsControl>

          </StackPanel>

        </Border>

      </DataTemplate>

      <DataTemplate x:Key="KeyValueRow">

        <Grid Margin="0,3">

          <TextBlock Foreground="{DynamicResource Muted}" Text="{Binding Key}" />

          <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource Mono}" Text="{Binding Value}" />

        </Grid>

      </DataTemplate>

      <DataTemplate x:Key="Meter">

        <Grid Margin="0,0,0,12">

          <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

          </Grid.RowDefinitions>

          <Grid.ColumnDefinitions>

            <ColumnDefinition Width="Auto" />

            <ColumnDefinition Width="*" />

          </Grid.ColumnDefinitions>

          <TextBlock Foreground="{DynamicResource Muted}" Margin="0,0,12,0" Text="{Binding Label}" />

          <TextBlock Grid.Column="1" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Mono}" Text="{Binding Value}" />

          <Grid Row="1" ColumnSpan="2" Height="4" Margin="0,6,0,0" Background="{DynamicResource Line}">

            <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">

              <UIElement.RenderTransform>

                <ScaleTransform ScaleX="{Binding Fraction}" />

              </UIElement.RenderTransform>

            </Border>

          </Grid>

        </Grid>

      </DataTemplate>

      <Style x:Key="MonoCell" TargetType="{x:Type TextBlock}">

        <Setter Property="FontFamily" Value="{StaticResource Mono}" />

      </Style>

      <Style x:Key="MutedCell" TargetType="{x:Type TextBlock}">

        <Setter Property="Foreground" Value="{DynamicResource Muted}" />

      </Style>

      <Style x:Key="MutedMonoCell" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource MonoCell}">

        <Setter Property="Foreground" Value="{DynamicResource Muted}" />

      </Style>

    </ResourceDictionary>

  </FrameworkElement.Resources>

