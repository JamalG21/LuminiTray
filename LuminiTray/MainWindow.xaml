                                                </StackPanel>

                                                <Button x:Name="BtnApplyAutoNow" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="APLICAR FUNÇÕES AGORA" Padding="16,7" FontSize="11" Click="BtnApplyAutoNow_Click"/>

                                            </Grid>

                                        </Border>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>



                        <!-- Card 3: PROGRAMAS DE INICIALIZAÇÃO DO WINDOWS -->

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">

                            <StackPanel>

