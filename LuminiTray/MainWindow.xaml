                                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="{Binding Detail}"/>

                                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Text="{Binding Command}" ToolTip="{Binding Command}"/>

                                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="10.5" Margin="0,1,0,0" Text="{Binding Source}"/>

                                                    </StackPanel>

                                                    <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Content="REMOVER" Padding="12,5" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0" Tag="{Binding}" Click="StartupRemove_Click"/>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                                <TextBlock x:Name="StartupResult" TextWrapping="Wrap" Margin="0,10,0,0"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

        <ScrollViewer Name="PageMakerPorts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled">

