                                </Border>

                                <Border Background="#1A3B82F6" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="12,6">

                                    <TextBlock Text="✓ winget pronto" Foreground="#3B82F6" FontSize="11.5" FontWeight="SemiBold"/>

                                </Border>

                            </StackPanel>

                        </Grid>



                        <!-- Card de Descoberta Automática de Backups -->

                        <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,18">

                            <StackPanel>

                                <Grid Margin="0,0,0,12">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="BACKUPS ENCONTRADOS NO PENDRIVE E DISCOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Faint}"/>

                                        <TextBlock x:Name="TxtPostFormatScanStatus" Text="Procurando backups de drivers, redes Wi-Fi e programas..." FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                                        <Button x:Name="BtnPostFormatScanAgain" Style="{StaticResource OutlineButton}" Content="🔍 Procurar de novo" Padding="12,6" FontSize="11.5" Margin="0,0,8,0" Click="BtnPostFormatScanAgain_Click"/>

                                        <Button x:Name="BtnPostFormatChooseFolder" Style="{StaticResource OutlineButton}" Content="📁 Escolher pasta do backup..." Padding="12,6" FontSize="11.5" Click="BtnPostFormatChooseFolder_Click"/>

                                    </StackPanel>

                                </Grid>



                                <UniformGrid Columns="3" Margin="0,4,0,0">

                                    <Border Background="{DynamicResource CardSubtleBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">

                                        <Grid>

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto"/>

                                                <RowDefinition Height="*"/>

                                                <RowDefinition Height="Auto"/>

                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                                                    <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Accent}" Margin="0,0,8,0"/>

                                                    <TextBlock Text="Drivers" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource Fg}"/>

                                                </StackPanel>

                                                <CheckBox x:Name="ChkPostFormatCategoryDrivers" Content="Incluir Drivers na fila" Tag="Drivers" IsChecked="True" FontSize="11" Margin="0,0,0,6" Click="ChkPostFormatCategory_Click"/>

                                            </StackPanel>

                                            <TextBlock Grid.Row="1" x:Name="TxtPostFormatDiscoveredDrivers" Text="Nenhum backup detectado" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <Button Grid.Row="2" x:Name="BtnPostFormatRunDrivers" Style="{StaticResource OutlineButton}" Content="Restaurar Drivers" Padding="8,4" FontSize="10.5" HorizontalAlignment="Left" Click="BtnPostFormatRunDrivers_Click"/>

                                        </Grid>

                                    </Border>



                                    <Border Background="{DynamicResource CardSubtleBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0,4,0">

                                        <Grid>

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto"/>

                                                <RowDefinition Height="*"/>

                                                <RowDefinition Height="Auto"/>

                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                                                    <TextBlock Text="&#xE701;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="#10B981" Margin="0,0,8,0"/>

                                                    <TextBlock Text="Redes Wi-Fi &amp; Senhas" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource Fg}"/>

                                                </StackPanel>

                                                <CheckBox x:Name="ChkPostFormatCategoryWifi" Content="Incluir Redes Wi-Fi na fila" Tag="WiFi" IsChecked="True" FontSize="11" Margin="0,0,0,6" Click="ChkPostFormatCategory_Click"/>

                                            </StackPanel>

                                            <TextBlock Grid.Row="1" x:Name="TxtPostFormatDiscoveredWifi" Text="Nenhum backup detectado" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <Button Grid.Row="2" x:Name="BtnPostFormatRunWifi" Style="{StaticResource OutlineButton}" Content="Restaurar Redes" Padding="8,4" FontSize="10.5" HorizontalAlignment="Left" Click="BtnPostFormatRunWifi_Click"/>

                                        </Grid>

                                    </Border>



                                    <Border Background="{DynamicResource CardSubtleBg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">

                                        <Grid>

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="Auto"/>

                                                <RowDefinition Height="*"/>

                                                <RowDefinition Height="Auto"/>

                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0">

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                                                    <TextBlock Text="&#xE74C;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="#F59E0B" Margin="0,0,8,0"/>

                                                    <TextBlock Text="Programas (Winget)" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource Fg}"/>

                                                </StackPanel>

                                                <CheckBox x:Name="ChkPostFormatCategoryApps" Content="Incluir Programas na fila" Tag="Apps" IsChecked="True" FontSize="11" Margin="0,0,0,6" Click="ChkPostFormatCategory_Click"/>

                                            </StackPanel>

                                            <TextBlock Grid.Row="1" x:Name="TxtPostFormatDiscoveredApps" Text="Nenhum backup detectado" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                            <Button Grid.Row="2" x:Name="BtnPostFormatRunApps" Style="{StaticResource OutlineButton}" Content="Restaurar Programas" Padding="8,4" FontSize="10.5" HorizontalAlignment="Left" Click="BtnPostFormatRunApps_Click"/>

                                        </Grid>

                                    </Border>

                                </UniformGrid>

                            </StackPanel>

                        </Border>



                        <!-- Fila de Instalação e Execução -->

                        <Border Style="{StaticResource CardBorder}" Padding="20">

                            <StackPanel>

                                <Grid Margin="0,0,0,16">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="FILA DE INSTALAÇÃO EM LOTE" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Fg}"/>

                                        <TextBlock x:Name="TxtPostFormatQueueSummary" Text="0 itens na fila" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0"/>

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal">

                                        <CheckBox x:Name="ChkPostFormatAutoResume" Content="Continuar automaticamente ao iniciar o Windows" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource Muted}" FontSize="11.5"/>

                                        <Button x:Name="BtnPostFormatReset" Style="{StaticResource GhostButton}" Content="Limpar Fila" Padding="10,6" FontSize="11.5" Margin="0,0,8,0" Click="BtnPostFormatReset_Click"/>

                                        <Button x:Name="BtnPostFormatPause" Style="{StaticResource OutlineButton}" Content="⏸️ Parar" Padding="14,8" FontSize="11.5" IsEnabled="False" Margin="0,0,8,0" Click="BtnPostFormatPause_Click"/>

                                        <Button x:Name="BtnPostFormatExecuteAll" Style="{StaticResource PrimaryButton}" Content="📥 EXECUTAR TUDO" Padding="20,8" FontSize="11.5" Click="BtnPostFormatExecuteAll_Click"/>

                                    </StackPanel>

                                </Grid>



                                <ProgressBar x:Name="PgbPostFormatProgress" Height="4" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource Line}" Foreground="{DynamicResource Accent}" Margin="0,0,0,12"/>

                                <TextBlock x:Name="TxtPostFormatCurrentAction" Text="Aguardando início..." Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="0,0,0,14"/>



                                <!-- Lista de Itens da Fila -->

                                <ListView x:Name="LstPostFormatQueue" MaxHeight="450" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListView.ItemContainerStyle>

                                        <Style TargetType="ListViewItem">

                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                            <Setter Property="Padding" Value="8,8"/>

                                            <Setter Property="Margin" Value="0,0,0,4"/>

                                            <Setter Property="Background" Value="{DynamicResource CardSubtleBg}"/>

                                            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>

                                            <Setter Property="BorderThickness" Value="1"/>

                                        </Style>

                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>

                                        <DataTemplate>

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="Auto"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Marque para incluir este item na execução" Click="PostFormatQueueItem_Click"/>

                                                <TextBlock Grid.Column="1" Text="{Binding Icon}" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">

                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Fg}"/>

                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Muted}"/>

                                                </StackPanel>

                                                <Border Grid.Column="3" CornerRadius="4" Padding="10,4" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">

                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>

                                                </Border>

                                            </Grid>

                                        </DataTemplate>

                                    </ListView.ItemTemplate>

                                </ListView>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>



                <!-- ===== REPARAR O WINDOWS ===== -->

                <ScrollViewer x:Name="PageWindowsRepair" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="36,26,36,36">

                        <!-- Cabeçalho -->

                        <Grid Margin="0,0,0,20">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource Icons}" FontSize="24" Foreground="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <TextBlock Text="REPARAR O WINDOWS" Style="{StaticResource H1}" VerticalAlignment="Center"/>

                                </StackPanel>

                                <TextBlock Text="Conserta erros do próprio Windows com ferramentas oficiais da Microsoft na ordem recomendada: disco, arquivos corrompidos, WMI, ícones e rede. Um ponto de restauração é criado antes de iniciar." Style="{StaticResource Sub}" TextWrapping="Wrap"/>

                            </StackPanel>

                        </Grid>



                        <!-- Barra de Ações -->

                        <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,0,0,18">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                    <TextBlock x:Name="TxtWindowsRepairSummary" Text="7 reparos marcados • cerca de 15 a 45 min" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Fg}"/>

                                    <TextBlock Text="Você pode continuar usando o PC normalmente durante a execução." FontSize="11.5" Foreground="{DynamicResource Muted}"/>

                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                                    <Button Style="{StaticResource OutlineButton}" Content="Só os recomendados" Padding="14,8" FontSize="11.5" Margin="0,0,8,0" Click="BtnWindowsRepairSelectRecommended_Click"/>

                                    <Button x:Name="BtnWindowsRepairCancel" Style="{StaticResource OutlineButton}" Content="⏹️ Cancelar" Padding="14,8" FontSize="11.5" IsEnabled="False" Margin="0,0,8,0" Click="BtnWindowsRepairCancel_Click"/>

                                    <Button x:Name="BtnWindowsRepairStart" Style="{StaticResource PrimaryButton}" Content="🔧 REPARAR AGORA" Padding="20,8" FontSize="11.5" Click="BtnWindowsRepairStart_Click"/>

                                </StackPanel>

                            </Grid>

                        </Border>



                        <!-- Card de Conclusão / Reinício -->

                        <Border x:Name="BrdWindowsRepairResult" Style="{StaticResource CardBorder}" Background="#1A10B981" BorderBrush="#10B981" Padding="18" Margin="0,0,0,18" Visibility="Collapsed">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">

                                        <TextBlock Text="✓" FontWeight="Bold" FontSize="16" Foreground="#10B981" Margin="0,0,8,0"/>

                                        <TextBlock x:Name="TxtWindowsRepairResultSummary" Text="Reparo concluído às 19:57 • tudo certo" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Fg}"/>

                                    </StackPanel>

                                    <TextBlock Text="As ferramentas oficiais do Windows corrigiram os arquivos e registros selecionados." Foreground="{DynamicResource Muted}" FontSize="11.5"/>

                                </StackPanel>

                                <Button Grid.Column="1" x:Name="BtnWindowsRepairReboot" Style="{StaticResource PrimaryButton}" Content="🔄 Reiniciar agora" Padding="16,8" FontSize="11.5" Click="BtnWindowsRepairReboot_Click"/>

                            </Grid>

                        </Border>



                        <!-- Lista de Reparos -->

                        <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,18">

                            <StackPanel>

                                <ProgressBar x:Name="PgbWindowsRepair" Height="4" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource Line}" Foreground="{DynamicResource Accent}" Margin="0,0,0,14"/>

                                <ListView x:Name="LstWindowsRepairTasks" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListView.ItemContainerStyle>

                                        <Style TargetType="ListViewItem">

                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                            <Setter Property="Padding" Value="12,10"/>

                                            <Setter Property="Margin" Value="0,0,0,6"/>

                                            <Setter Property="Background" Value="{DynamicResource CardSubtleBg}"/>

                                            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>

                                            <Setter Property="BorderThickness" Value="1"/>

                                        </Style>

                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>

                                        <DataTemplate>

                                            <Grid>

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="Auto"/>

                                                    <ColumnDefinition Width="*"/>

                                                    <ColumnDefinition Width="Auto"/>

                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}" Checked="ChkRepairTask_Changed" Unchecked="ChkRepairTask_Changed" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">

                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Fg}" Margin="0,0,8,0"/>

                                                        <Border Visibility="{Binding IsRecommended, Converter={StaticResource BoolVis}}" Background="#1A10B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">

                                                            <TextBlock Text="Recomendado" Foreground="#10B981" FontSize="10" FontWeight="SemiBold"/>

                                                        </Border>

                                                        <TextBlock Text="{Binding EstimatedDuration, StringFormat='⏱️ {0}'}" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center"/>

                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>

                                                </StackPanel>

                                                <Border Grid.Column="2" CornerRadius="4" Padding="10,4" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" VerticalAlignment="Center">

                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>

                                                </Border>

                                            </Grid>

                                        </DataTemplate>

                                    </ListView.ItemTemplate>

                                </ListView>

                            </StackPanel>

                        </Border>



                        <!-- Console de Log em Tempo Real -->

                        <Border Style="{StaticResource CardBorder}" Padding="16">

                            <StackPanel>

                                <TextBlock Text="REGISTRO DE SAÍDA OFICIAL DAS FERRAMENTAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Faint}" Margin="0,0,0,8"/>

                                <ScrollViewer x:Name="ScrWindowsRepairLogs" Height="140" Background="{DynamicResource CardSubtleBg}" Padding="10" VerticalScrollBarVisibility="Auto">

                                    <TextBlock x:Name="TxtWindowsRepairLogs" Text="Pronto para iniciar reparo." FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>

                                </ScrollViewer>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

      </Grid>

    </Grid>

  </Border>

</Window>

