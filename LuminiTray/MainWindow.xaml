          <Grid Name="BenchPanelRt" Row="2" Visibility="Collapsed">

            <Grid.ColumnDefinitions>

              <ColumnDefinition Width="*" />

              <ColumnDefinition Width="16" />

              <ColumnDefinition Width="310" />

            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">

              <StackPanel>

                <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="24,20" Margin="0,0,0,12">

                  <StackPanel>

                    <TextBlock Text="CIDADE DE OBJETOS · RAY TRACING POR HARDWARE" Style="{StaticResource Label}" />

                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}">Direct3D 12 com DXR 1.1: usa os núcleos de ray tracing da placa (RTX 20 ou mais nova, Radeon RX 6000 ou mais nova, Intel Arc). 4 mil objetos em materiais fosco, metal e espelho; por pixel, path tracing com sombras suaves, oclusão de ambiente, reflexos de reflexos e iluminação indireta. A estrutura de aceleração é refeita a cada frame, com objetos girando, como nos jogos. Abre numa janela própria; ESC cancela.</TextBlock>

                    <Grid Margin="0,22,0,0">

                      <StackPanel>

                        <TextBlock Text="FPS AGORA" Style="{StaticResource Label}" />

                        <TextBlock Name="RtFpsNow" Text="—" FontFamily="{StaticResource Mono}" FontSize="44" />

                      </StackPanel>

                      <StackPanel HorizontalAlignment="Right">

                        <TextBlock Text="ETAPA" Style="{StaticResource Label}" HorizontalAlignment="Right" />

                        <TextBlock Name="RtPhase" Text="—" FontFamily="{StaticResource Mono}" FontSize="20" HorizontalAlignment="Right" />

                      </StackPanel>

                    </Grid>

                    <Grid Height="3" Margin="0,14,0,8" Background="{DynamicResource Line}">

                      <Border Background="{DynamicResource Fg}" RenderTransformOrigin="0,0.5">

                        <UIElement.RenderTransform>

                          <ScaleTransform x:Name="RtProgress" ScaleX="0" />

                        </UIElement.RenderTransform>

                      </Border>

                    </Grid>

                    <TextBlock Name="RtStatus" Text="Pronto" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" />

                  </StackPanel>

                </Border>

                <Border Style="{StaticResource CardBorder}" Padding="24,20">

                  <StackPanel>

                    <TextBlock Text="COMO COMPARAR COM CONFIANÇA" Style="{StaticResource Label}" />

                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12">O teste aquece a placa sem medir (o clock e a temperatura se estabilizam) e depois roda 3 passadas iguais. A nota usa a MEDIANA das passadas, e a variação entre elas mostra se o resultado é confiável (abaixo de 3%). O tempo de cada frame vem do relógio da própria GPU. Compare só resultados com a mesma resolução e o mesmo preset, com o PC na tomada, sem outros programas pesados abertos e com o mesmo driver. A cena é sempre a mesma (sementes fixas), em qualquer PC.</TextBlock>

                    <TextBlock Text="REFERÊNCIA MEDIDA" Style="{StaticResource Label}" Margin="0,14,0,4" />

