                                                            <Grid.ColumnDefinitions>

                                                                <ColumnDefinition Width="Auto"/>

                                                                <ColumnDefinition Width="*"/>

                                                                <ColumnDefinition Width="Auto"/>

                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                            <StackPanel Grid.Column="1">

                                                                <StackPanel Orientation="Horizontal">

                                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource Fg}"/>

                                                                    <Border Background="{DynamicResource Line}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">

                                                                        <TextBlock Text="{Binding Type}" FontSize="9.5" Foreground="{DynamicResource Muted}"/>

                                                                    </Border>

                                                                </StackPanel>

                                                                <TextBlock Text="{Binding FormattedSubtitle}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0"/>

                                                            </StackPanel>

                                                            <TextBlock Grid.Column="2" Text="{Binding FormattedDelay}" FontWeight="Bold" FontSize="12.5" Foreground="#EF4444" VerticalAlignment="Center"/>

                                                        </Grid>

                                                    </Border>

                                                </DataTemplate>

                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </StackPanel>

                                </Border>

                            </StackPanel>

                        </Border>



                        <!-- Card 2: INICIALIZAÇÃO AUTOMÁTICA DO LUMINI TRAY -->

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20,18">

                            <StackPanel>

                                <Grid Margin="0,0,0,14">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,20,0">

                                        <TextBlock Text="INICIALIZAÇÃO AUTOMÁTICA DO LUMINI TRAY" Style="{StaticResource Label}"/>

                                        <TextBlock Text="Iniciar junto com o Windows para aplicar funções automáticas" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/>

                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">Inicia com privilégios elevados via Agendador de Tarefas do Windows (sem bloqueio de UAC) e executa automaticamente as rotinas de otimização configuradas abaixo.</TextBlock>

                                    </StackPanel>

                                    <CheckBox x:Name="ChkAutoStartWithWindows" Grid.Column="1" VerticalAlignment="Center" Content="INICIAR COM O WINDOWS" FontWeight="Bold" FontSize="12" Click="ChkAutoStartWithWindows_Click"/>

                                </Grid>

                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">

                                    <StackPanel>

                                        <TextBlock Text="FUNÇÕES AUTOMÁTICAS AO INICIAR" Style="{StaticResource Label}" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,10">

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="*"/>

                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">

                                                <CheckBox x:Name="ChkAutoCleanRam" Content="Limpar memória RAM e lista em espera" FontWeight="SemiBold" FontSize="12.5" Click="AutoFeatureOption_Click"/>

                                                <TextBlock Text="Esvazia a lista em espera do Windows e enxuga processos para máxima RAM livre." Foreground="{DynamicResource Faint}" FontSize="11" Margin="24,2,0,10" TextWrapping="Wrap"/>

                                                <CheckBox x:Name="ChkAutoApplyTweaks" Content="Aplicar ajustes de desempenho do Windows" FontWeight="SemiBold" FontSize="12.5" Click="AutoFeatureOption_Click"/>

                                                <TextBlock Text="Aplica Plano Alto Desempenho, Modo de Jogo, Game DVR desligado e otimizações de janela." Foreground="{DynamicResource Faint}" FontSize="11" Margin="24,2,0,0" TextWrapping="Wrap"/>

                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">

                                                <CheckBox x:Name="ChkAutoCloseApps" Content="Fechar programas dispensáveis em segundo plano" FontWeight="SemiBold" FontSize="12.5" Click="AutoFeatureOption_Click"/>

