        </ScrollViewer>



                <!-- ===== INICIALIZAÇÃO DO WINDOWS & BOOT TIME ===== -->

                <ScrollViewer x:Name="PageStartup" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" CanContentScroll="False" HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="36,30,36,30">

                        <Grid Margin="0,0,0,20">

                            <StackPanel Margin="0,0,190,0">

                                <TextBlock Text="INICIALIZAÇÃO DO WINDOWS" Style="{StaticResource H1}"/>

