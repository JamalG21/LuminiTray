<Window x:Class="LuminiTray.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumini Tray - Overlay de Jogos" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResize" Focusable="False"
        MinWidth="140" MinHeight="60" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewMouseWheel="Window_PreviewMouseWheel" MouseDown="Window_MouseDown">
    <Border x:Name="Box" Background="#D9000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10,8"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="True">
        <Grid>
            <!-- Badge de opacidade breve (fora da área escalada) -->
            <TextBlock x:Name="TxtOpacityBadge" Text="85%" FontSize="10" FontWeight="Bold" Foreground="#99FFFFFF"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" Panel.ZIndex="5"/>

            <!-- Conteúdo: escalado conforme o tamanho da janela; a largura útil extra vai para o gráfico e as linhas -->
            <Grid x:Name="ContentRoot" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <StackPanel x:Name="ContentStack" HorizontalAlignment="Left" TextElement.FontFamily="Cascadia Mono, Consolas" TextElement.FontSize="12" TextElement.Foreground="#F5F5F5">
                    <StackPanel x:Name="OFpsRow" Orientation="Horizontal">
                        <TextBlock x:Name="OFps" Text="—" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="OFpsUnit" Text=" FPS" Foreground="#8C8C8C" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        <TextBlock x:Name="OFrameTime" Text="" Foreground="#8C8C8C" VerticalAlignment="Bottom" Margin="12,0,0,4"/>
                    </StackPanel>
                    <TextBlock x:Name="OLow" Text="1% low —" Foreground="#8C8C8C"/>
                    <Canvas x:Name="OGraph" Height="30" Margin="0,6,0,4" ClipToBounds="True" HorizontalAlignment="Stretch"/>
                    <ItemsControl x:Name="ORows" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="#8C8C8C"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" HorizontalAlignment="Right" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="OGame" Text="" Foreground="#5A5A5A" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
