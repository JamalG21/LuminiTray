<Window x:Class="LuminiTray.StressReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lumini Tray — Relatório do Teste de Stress"
        Width="980" Height="720" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de Título / Cabeçalho Superior -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="28,18" Background="{DynamicResource Card}">
            <DockPanel LastChildFill="True">
                <!-- Botões de Ação Rápida no Topo Direito -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCopyScreenshot" Style="{StaticResource PrimaryButton}" Content="📸 COPIAR CAPTURA" Padding="14,8" Margin="0,0,8,0" Click="BtnCopyScreenshot_Click" ToolTip="Copia a imagem completa do relatório para a área de transferência"/>
                    <Button x:Name="BtnSaveScreenshot" Style="{StaticResource OutlineButton}" Content="💾 SALVAR PNG" Padding="14,8" Margin="0,0,8,0" Click="BtnSaveScreenshot_Click" ToolTip="Salva a imagem do relatório em arquivo"/>
                    <Button x:Name="BtnCloseTop" Style="{StaticResource OutlineButton}" Content="FECHAR" Padding="14,8" Click="BtnClose_Click"/>
                </StackPanel>

                <!-- Título e Status -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="Lumini Tray" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border x:Name="BrdVerdictBadge" CornerRadius="4" Padding="10,3" Background="{DynamicResource Fg}" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVerdictBadge" Text="ESTÁVEL · APROVADO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Bg}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtReportSub" Text="Relatório do Teste de Estresse Térmico e Estabilidade do Sistema" FontSize="12" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Conteúdo Principal com ScrollViewer para Redimensionamento Flexível -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="ReportCaptureArea" Background="{DynamicResource Bg}" Padding="28,24">
                <StackPanel>
                    <!-- Linha de Metadados: Duração, Data e Veredito -->
                    <Border Style="{StaticResource CardBorder}" Padding="20,16" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DATA &amp; HORA" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtMetaDate" Text="25/10/2026 14:00" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DURAÇÃO DO TESTE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtMetaDuration" Text="10 min 00 s" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="DESFECHO" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtMetaResult" Text="Concluído com Êxito" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="INTEGRIDADE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtMetaIntegrity" Text="0 erros detectados" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Seção: Especificações de Hardware (CPU, GPU, RAM) -->
                    <TextBlock Text="CONFIGURAÇÃO DE HARDWARE SOB ESTRESSE" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Processador (CPU) -->
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="18,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="PROCESSADOR (CPU)" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtCpuModel" Text="Processador" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtCpuCores" Text="8 Núcleos / 16 Threads" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>

                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Temp. Máxima:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtCpuMaxTemp" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Limite Configurado:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtCpuLimitTemp" Text="90 °C" HorizontalAlignment="Right" FontSize="11.5"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Consumo de Pico:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtCpuMaxPower" Text="—" HorizontalAlignment="Right" FontSize="11.5"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Carga Durante Teste:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtCpuLoad" Text="100%" HorizontalAlignment="Right" FontSize="11.5"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Placa de Vídeo (GPU) -->
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="18,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🎮" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="PLACA DE VÍDEO (GPU)" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtGpuModel" Text="Placa de Vídeo" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtGpuVram" Text="VRAM" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>

                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Temp. Máxima:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtGpuMaxTemp" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Limite Configurado:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtGpuLimitTemp" Text="85 °C" HorizontalAlignment="Right" FontSize="11.5"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Consumo de Pico:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtGpuMaxPower" Text="—" HorizontalAlignment="Right" FontSize="11.5"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="FPS Médio / Frames:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtGpuFps" Text="—" HorizontalAlignment="Right" FontSize="11.5"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Memória RAM -->
                        <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="18,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🧠" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="MEMÓRIA RAM" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtRamTotal" Text="Memória RAM" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtRamSpeed" Text="Velocidade / Tipo" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,10"/>

                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Passes Concluídos:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtRamPasses" Text="—" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Erros de Memória:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtRamErrors" Text="0 erros" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11.5"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Uso da Memória:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtRamUsage" Text="Carga Completa" HorizontalAlignment="Right" FontSize="11.5"/>
                                        </Grid>
                                        <Grid Margin="0,2">
                                            <TextBlock Text="Status do Módulo:" Foreground="{DynamicResource Muted}" FontSize="11.5"/>
                                            <TextBlock x:Name="TxtRamStatus" Text="Estável" HorizontalAlignment="Right" FontSize="11.5"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Registro de Eventos e Histórico -->
                    <Border Style="{StaticResource CardBorder}" Padding="20,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="HISTÓRICO E REGISTRO DO TESTE" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                            <ListBox x:Name="LstReportLogs" MaxHeight="160" FontFamily="{StaticResource Mono}" FontSize="11.5"
                                     Foreground="{DynamicResource Muted}" ItemContainerStyle="{StaticResource PlainItem}"/>
                        </StackPanel>
                    </Border>

                    <!-- Rodapé do Relatório -->
                    <DockPanel>
                        <TextBlock Text="Lumini Tray · Relatório Oficial de Estabilidade e Desempenho Térmico" FontSize="11" Foreground="{DynamicResource Faint}"/>
                        <TextBlock Text="Validação com Precisão de Hardware" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Faint}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Barra Inferior -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,14" Background="{DynamicResource Card}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Dica: Redimensione a janela arrastando as bordas para o formato ideal antes de capturar o print." FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource PrimaryButton}" Content="📸 COPIAR PRINT" Padding="16,8" Margin="0,0,8,0" Click="BtnCopyScreenshot_Click"/>
                    <Button Style="{StaticResource OutlineButton}" Content="💾 SALVAR IMAGEM" Padding="14,8" Margin="0,0,8,0" Click="BtnSaveScreenshot_Click"/>
                    <Button Style="{StaticResource OutlineButton}" Content="FECHAR" Padding="14,8" Click="BtnClose_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>